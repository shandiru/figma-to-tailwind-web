PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/figma_to_tailwind
CLIENT_URL=http://localhost:5173
MAX_FILE_MB=128
# Optional: enables Figma link imports without entering a token in the UI.
# Personal access token requires file_content:read permission.
FIGMA_ACCESS_TOKEN=
# Gmail App Password; never place these values in frontend/VITE_ variables.
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Optional secret phrase to assign Super Admin role during account registration.
# Set only in the backend environment; never use a VITE_ variable.
SUPER_ADMIN_CREATE_KEYWORD=
# Keep lax when using the frontend /api proxy (recommended).
COOKIE_SAME_SITE=lax
# Optional persistent path for ZIP storage on a Node host.
STORAGE_DIR=
# SEO keyword job (see docs/daily-seo-keywords.md).
# Local use: save the Google service-account JSON key under backend/secrets/.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/google-service-account.json
# Alternatively set one of these instead of GOOGLE_SERVICE_ACCOUNT_KEY_FILE.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
SEO_GA4_PROPERTY_ID=
SEO_SEARCH_CONSOLE_SITE=https://figma-to-code.imdiru.online/
SEO_LOOKBACK_DAYS=90
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
SEO_REPORT_TO=
# Local setTimeout scheduler time (requires this Node process to stay running).
SEO_SCHEDULE_TIMEZONE=Asia/Colombo
SEO_SCHEDULE_HOUR=10
SEO_SCHEDULE_MINUTE=26
